# Copy to .env and replace every value. PLACEHOLDERS ONLY - never commit real secrets.

# Postgres owner role (owns the schema, runs migrations)
POSTGRES_PASSWORD=replace-me-owner-password

# Restricted application role the API connects as
APP_DB_PASSWORD=replace-me-app-password

# HS256 signing key for access tokens. The application has NO default for this:
# app.core.config.Settings requires JWT_SECRET and fails fast if it is absent.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-long-random-string

# Password given to every seeded fixture user (development fixtures only)
SEED_PASSWORD=replace-me-seed-password

# Host port mappings
DB_HOST_PORT=5432
API_HOST_PORT=8080
